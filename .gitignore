# Secretos: nunca se versionan (ver app/backend/.env.example)
.env
**/.env
.env.*
!**/.env.example

# Python
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Claude Code: configuración personal y resultados de evaluaciones de skills
.claude/settings.local.json
.claude/skills/*-workspace/
**/evals/results/

# Editores / SO
.vscode/
.idea/
.DS_Store

# Worktrees de agentes (ramas de trabajo aisladas)
.worktrees/

# symlink de la venv en worktrees
app/backend/.venv

# Bitácora: los prompts textuales quedan solo en local (el repo es público)
.claude/bitacora/prompts/

# Copiar a .env (NO versionar .env) y reemplazar los <...> por valores reales.
# Generar secretos con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

FLASK_APP=app:create_app
FLASK_DEBUG=1

# MySQL (contenedor mysql8). En docker-compose DB_HOST se sobreescribe a host.docker.internal
DB_HOST=localhost
DB_PORT=3306
DB_NAME=delivery3d
DB_TEST_NAME=delivery3d_test
DB_USER=<usuario_mysql>
DB_PASSWORD=<password_mysql>

# JWT
JWT_SECRET_KEY=<secreto_largo_aleatorio>

# Seed del operador admin (seeds/seed_operator.py)
SEED_OPERATOR_USERNAME=operador
SEED_OPERATOR_PASSWORD=<password_operador>
